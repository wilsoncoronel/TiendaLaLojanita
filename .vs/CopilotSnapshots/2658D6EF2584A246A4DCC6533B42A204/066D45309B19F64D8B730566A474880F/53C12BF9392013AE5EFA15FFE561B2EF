        private async Task AgregarArticuloDesdeBusqueda()
        {
            string consulta = this.txtArtículo.Text.Trim();
            if (string.IsNullOrWhiteSpace(consulta))
            {
                MessageBox.Show("Ingrese un nombre, código, lote o ID de artículo.", "Dato requerido", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            var articulo = this.ListaArticulosVenta.FirstOrDefault(item =>
                string.Equals(item.Nombre, consulta, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(item.Codigo, consulta, StringComparison.OrdinalIgnoreCase) ||
                string.Equals(item.Lote, consulta, StringComparison.OrdinalIgnoreCase));

            if (articulo == null && int.TryParse(consulta, out int idArticulo))
            {
                articulo = this.ListaArticulosVenta.FirstOrDefault(item => item.Id == idArticulo);
            }

            if (articulo == null)
            {
                MessageBox.Show("No se encontró ningún artículo con el valor ingresado.", "Artículo no encontrado", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            await this.AgregarArticulo(articulo);
        }

        private async Task AgregarArticulo(ArticuloVentaDTO articuloBusqueda)
        {
            try
            {
                var articuloInventario = await this.articuloService.ObtenerArticuloInventarioId(articuloBusqueda.Id);
                if (articuloInventario == null || articuloInventario.IdArticulo == 0)
                {
                    MessageBox.Show("El artículo no tiene inventario disponible.", "Artículo no disponible", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return;
                }

                var articulo = await this.articuloService.ObtenerArticuloId(articuloBusqueda.Id);
                var codigo = articuloInventario.Codigo ?? articuloBusqueda.Codigo ?? string.Empty;
                var lote = articuloInventario.NumeroLote ?? articuloBusqueda.Lote ?? string.Empty;
                var existente = this.detallesDevolucion.FirstOrDefault(detalle =>
                    detalle.IdArticulo == articuloInventario.IdArticulo &&
                    string.Equals(detalle.Lote, lote, StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(detalle.Codigo, codigo, StringComparison.OrdinalIgnoreCase));

                if (existente != null)
                {
                    existente.Cantidad++;
                    this.SincronizarFila(existente);
                    this.CalcularTotales();
                    this.LimpiarBusquedaArticulo();
                    return;
                }

                var detalleNuevo = new DetalleDevolucionMemoria
                {
                    IdArticulo = articuloInventario.IdArticulo,
                    Lote = lote,
                    Codigo = codigo,
                    NombreArticulo = articulo?.Nombre ?? articuloInventario.Articulo.Nombre ?? articuloBusqueda.Nombre,
                    Valor = articuloInventario.Articulo.ValorCompra,
                    Cantidad = 1,
                    Impuestos = await this.CopiarImpuestosArticulo(articulo)
                };

                this.detallesDevolucion.Add(detalleNuevo);
                this.AgregarFila(detalleNuevo);
                this.CalcularTotales();
                this.LimpiarBusquedaArticulo();
            }
            catch (ApiException ex)
            {
                ApiErrorHandler.Mostrar(ex);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Ocurrió un error al cargar el artículo: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private async Task<List<DetalleDevolucionCompraImpuestoDTO>> CopiarImpuestosArticulo(ArticuloDTO articulo)
        {
            var impuestos = (articulo?.ArticulosImpuestosDTO ?? new List<ArticuloImpuestoMinDTO>())
                .Where(item => item.Estado && item.ImpuestoDTO != null)
                .Select(item => new DetalleDevolucionCompraImpuestoDTO
                {
                    IdImpuesto = item.ImpuestoDTO.Id,
                    Nombre = item.ImpuestoDTO.Nombre,
                    TipoCalculo = item.ImpuestoDTO.TipoCalculo,
                    Valor = item.ImpuestoDTO.Valor,
                    Estado = true
                })
                .ToList();

            if (impuestos.Count > 0 || articulo == null)
            {
                return impuestos;
            }

            var impuestosArticulo = await this.articuloService.ListaImpuestosArticuloId(articulo.Id);
            return (impuestosArticulo ?? new List<ImpuestoDTO>())
                .Select(impuesto => new DetalleDevolucionCompraImpuestoDTO
                {
                    IdImpuesto = impuesto.Id,
                    Nombre = impuesto.Nombre,
                    TipoCalculo = impuesto.TipoCalculo,
                    Valor = impuesto.Valor,
                    Estado = impuesto.Estado
                })
                .ToList();
        }

