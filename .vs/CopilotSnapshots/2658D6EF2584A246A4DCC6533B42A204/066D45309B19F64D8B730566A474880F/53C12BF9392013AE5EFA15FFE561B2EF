        private void ConfigurarAutocompletadoArticulos()
        {
            var articulosAutoComplete = new AutoCompleteStringCollection();
            foreach (var articulo in this.ListaArticulosVenta)
            {
                foreach (var valor in new[] { articulo.Nombre, articulo.Codigo, articulo.Lote })
                {
                    if (!string.IsNullOrWhiteSpace(valor) && !articulosAutoComplete.Contains(valor))
                    {
                        articulosAutoComplete.Add(valor);
                    }
                }
            }

            this.txtArtículo.AutoCompleteCustomSource = articulosAutoComplete;
            this.txtArtículo.AutoCompleteMode = AutoCompleteMode.Suggest;
            this.txtArtículo.AutoCompleteSource = AutoCompleteSource.CustomSource;
        }

