        }

        private void CargarPersonaNuevosDatos()
        {
            string errores = "";

            try
            {
                // ==========================
                // DATOS GENERALES
                // ==========================
                persona.Nombres = txtNombres.Text.Trim();
                persona.Apellidos = txtApellidos.Text.Trim();
                persona.Mail = txtEmail.Text.Trim();
                persona.Identificacion = txtIdentificacion.Text.Trim();
                persona.Telefono = txtTelefono.Text.Trim();

                // Tipo de Identificación (obligatorio)
                if (cbxTipoIdentificacion.SelectedValue is int idTipoId && idTipoId > 0)
                {
                    persona.IdTipoIdentificacion = idTipoId;
                    var tipoSeleccionado = ListaTipoIdentificacion.FirstOrDefault(x => x.Id == idTipoId);
                    if (tipoSeleccionado != null)
                    {
                        persona.TipoIdentificacionDTO = tipoSeleccionado;
                    }
                }
                else
                {
                    errores += "• Tipo de Identificación es obligatorio.\n";
                }

                // ==========================
                // DIRECCIÓN
                // ==========================
                if (cbxCiudad.SelectedValue is int idCiudad && idCiudad > 0 && !string.IsNullOrWhiteSpace(txtDireccion.Text))
                {
                    // Si ya existe dirección, actualizarla; si no, crearla
                    if (persona.DireccionesDTO == null)
                    {
                        persona.DireccionesDTO = new DireccionDTO();
                    }

                    persona.DireccionesDTO.Descripcion = txtDireccion.Text.Trim();
                    persona.DireccionesDTO.IdCiudad = idCiudad;

                    var ciudadSeleccionada = ListaCiudad.FirstOrDefault(x => x.Id == idCiudad);
                    if (ciudadSeleccionada != null)
                    {
                        persona.DireccionesDTO.CiudadDTO = ciudadSeleccionada;
                    }
                }
                else if (!string.IsNullOrWhiteSpace(txtDireccion.Text) || cbxCiudad.SelectedIndex >= 0)
                {
                    errores += "• Para la dirección: debe seleccionar una ciudad y escribir una descripción.\n";
                }

                // ==========================
                // CLIENTE
                // ==========================
                if (chxCliente.Checked)
                {
                    persona.EsCliente = true;

                    if (cbxEstadoCliente.SelectedIndex < 0 || cbxEstadoVisualCliente.SelectedIndex < 0)
                    {
                        errores += "• Cliente: debe seleccionar estado y estado visual.\n";
                    }
                    else
                    {
                        persona.EstadoCliente = cbxEstadoCliente.SelectedIndex == 0;
                        persona.EstadoVisualCliente = cbxEstadoVisualCliente.SelectedIndex == 0;
                    }
                }
                else
                {
                    persona.EsCliente = false;
                    persona.EstadoCliente = false;
                    persona.EstadoVisualCliente = false;
                }

                // ==========================
                // PROVEEDOR
                // ==========================
                if (chxProveedor.Checked)
                {
                    persona.EsProveedor = true;

                    if (cbxEstadoProv.SelectedIndex < 0 || cbxEstadoVisualProv.SelectedIndex < 0)
                    {
                        errores += "• Proveedor: debe seleccionar estado y estado visual.\n";
                    }
                    else
                    {
                        persona.EstadoProveedor = cbxEstadoProv.SelectedIndex == 0;
                        persona.EstadoVisualProveedor = cbxEstadoVisualProv.SelectedIndex == 0;
                        persona.RazonSocial = txtRazonSocialProveedor.Text.Trim();
                        persona.Descripcion = txtDescripcionProveedor.Text.Trim();
                    }
                }
                else
                {
                    persona.EsProveedor = false;
                    persona.EstadoProveedor = false;
                    persona.EstadoVisualProveedor = false;
                    persona.RazonSocial = "";
                    persona.Descripcion = "";
                }

                // ==========================
                // USUARIO
                // ==========================
                if (chxUser.Checked)
                {
                    persona.EsUsuario = true;

                    if (string.IsNullOrWhiteSpace(txtUsuario.Text))
                    {
                        errores += "• Usuario: nombre de usuario es obligatorio.\n";
                    }
                    else
                    {
                        persona.NombreUsuario = txtUsuario.Text.Trim();
                    }

                    if (cbxRol.SelectedValue is int idRol && idRol > 0)
                    {
                        var rolSeleccionado = ListaRol.FirstOrDefault(x => x.Id == idRol);
                        if (rolSeleccionado != null)
                        {
                            persona.Rol = rolSeleccionado;
                        }
                    }
                    else
                    {
                        errores += "• Usuario: debe seleccionar un rol.\n";
                    }

                    if (cbxEstadoUsuario.SelectedIndex < 0)
                    {
                        errores += "• Usuario: debe seleccionar estado.\n";
                    }
                    else
                    {
                        persona.EstadoUsuario = cbxEstadoUsuario.SelectedIndex == 0;
                    }
                }
                else
                {
                    persona.EsUsuario = false;
                    persona.NombreUsuario = "";
                    persona.Rol = null;
                    persona.EstadoUsuario = null;
                }

                // ==========================
                // MOSTRAR ERRORES
                // ==========================
                if (!string.IsNullOrEmpty(errores))
                {
                    MessageBox.Show("Errores encontrados:\n\n" + errores, "Validación de Datos", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }

                MessageBox.Show("Datos cargados correctamente.", "Éxito", MessageBoxButtons.OK, MessageBoxIcon.Information);
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error al cargar los datos: {ex.Message}", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }
    }
