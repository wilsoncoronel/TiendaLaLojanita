using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;
using TiendaLaLojanita.Models.DTO;
using TiendaLaLojanita.Models.Interfaces;
using TiendaLaLojanita.Services;

namespace TiendaLaLojanita.Views
{
    public partial class Formulario_Personas : Form
    {
        private PersonaCompletoDTO persona;
        private readonly IClienteService clienteService;
        private readonly ISistemaService sistemaService;
        private List<TipoIdentificacionDTO> ListaTipoIdentificacion;
        private List<RolDTO> ListaRol;
        private List<CiudadDTO> ListaCiudad;
        public Formulario_Personas(PersonaCompletoDTO persona, ISistemaService sistemaService, IClienteService clienteService)
        {
            InitializeComponent();
            this.persona = persona;
            this.clienteService = clienteService;
            this.sistemaService = sistemaService;
            this.CargarPersonaView();
            this.ListaTipoIdentificacion = new List<TipoIdentificacionDTO>();
            this.ListaRol = new List<RolDTO>();
            this.ListaCiudad = new List<CiudadDTO>();
            this.CargarListas();
            this.ComprobarChecks();
        }
        private async void CargarListas()
        {
            this.ListaCiudad = await this.clienteService.ListarCiudades();
            this.ListaTipoIdentificacion = await this.clienteService.ListarTiposIdentificacion();
            this.ListaRol = await this.sistemaService.ListaRoles();
            this.CargarCombos();
        }

        private void CargarCombos()
        {
            ConfigurarCombo(
                 cbxCiudad,
                 ListaCiudad,
                 "Nombre",
                 ListaCiudad.Select(x => x.Nombre));

            ConfigurarCombo(
                 cbxRol,
                 ListaRol,
                 "Nombre",
                 ListaRol.Select(x => x.Nombre));

            ConfigurarCombo(
                 cbxTipoIdentificacion,
                 ListaTipoIdentificacion,
                 "Nombre",
                 ListaTipoIdentificacion.Select(x => x.Nombre));
        }

        private void ConfigurarCombo<T>(
        ComboBox combo,
        object lista,
        string displayMember,
        IEnumerable<T> valores)
        {
            combo.DataSource = lista;
            combo.DisplayMember = displayMember;
            combo.ValueMember = "Id";

            combo.AutoCompleteMode = AutoCompleteMode.SuggestAppend;
            combo.AutoCompleteSource = AutoCompleteSource.CustomSource;

            var coleccion = new AutoCompleteStringCollection();

            foreach (var valor in valores)
            {
                if (valor != null)
                {
                    coleccion.Add(
                        valor.ToString()!.ToUpperInvariant());
                }
            }
            combo.AutoCompleteCustomSource = coleccion;
        }
        private void btnCancelar_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        private void CargarPersonaView()
        {
            if (persona is null)
                return;

            // ==========================
            // DATOS GENERALES
            // ==========================

            txtId.Text = persona.Id.ToString();

            chxCliente.Checked = persona.EsCliente;
            chxProveedor.Checked = persona.EsProveedor;
            chxUser.Checked = persona.EsUsuario;

            txtNombres.Text = persona.Nombres ?? string.Empty;
            txtApellidos.Text = persona.Apellidos ?? string.Empty;
            txtEmail.Text = persona.Mail ?? string.Empty;
            txtIdentificacion.Text = persona.Identificacion ?? string.Empty;
            txtTelefono.Text = persona.Telefono ?? string.Empty;

            // ==========================
            // DIRECCIÓN
            // ==========================

            if (persona.DireccionesDTO is not null)
            {
                txtDireccion.Text =
                    persona.DireccionesDTO.Descripcion ?? string.Empty;

                if (persona.DireccionesDTO.IdCiudad > 0)
                {
                    cbxCiudad.SelectedValue =
                        persona.DireccionesDTO.IdCiudad;
                }
            }
            else
            {
                txtDireccion.Clear();
                cbxCiudad.SelectedIndex = -1;
            }

            // ==========================
            // TIPO IDENTIFICACIÓN
            // ==========================

            if (persona.TipoIdentificacionDTO is not null)
            {
                cbxTipoIdentificacion.SelectedValue =
                    persona.TipoIdentificacionDTO.Id;
            }
            else
            {
                cbxTipoIdentificacion.SelectedIndex = -1;
            }

            // ==========================
            // CLIENTE
            // ==========================

            if (persona.EsCliente)
            {
                cbxEstadoCliente.SelectedIndex =
                    persona.EstadoCliente ? 0 : 1;
                cbxEstadoVisualCliente.SelectedIndex =
                    persona.EstadoVisualCliente ? 0 : 1;
            }
            else
            {
                cbxEstadoCliente.SelectedIndex = -1;
                cbxEstadoVisualCliente.SelectedIndex = -1;
            }

            // ==========================
            // PROVEEDOR
            // ==========================

            if (persona.EsProveedor)
            {
                cbxEstadoProv.SelectedIndex =
                    persona.EstadoProveedor ? 0 : 1;

                cbxEstadoVisualProv.SelectedIndex =
                    persona.EstadoVisualProveedor ? 0 : 1;
                txtRazonSocialProveedor.Text =
                    persona.RazonSocial ?? string.Empty;
                txtDescripcionProveedor.Text = persona.Descripcion ?? string.Empty;
            }
            else
            {
                cbxEstadoProv.SelectedIndex = -1;
                cbxEstadoVisualProv.SelectedIndex = -1;
                txtRazonSocialProveedor.Text =
                    persona.RazonSocial ?? string.Empty;
                txtDescripcionProveedor.Text = persona.Descripcion ?? string.Empty;
            }

            // ==========================
            // USUARIO
            // ==========================

            if (persona.EsUsuario)
            {
                txtUsuario.Text =
                    persona.NombreUsuario ?? string.Empty;

                if (persona.Rol is not null)
                {
                    cbxRol.SelectedValue = persona.Rol.Id;
                }
                else
                {
                    cbxRol.SelectedIndex = -1;
                }

                cbxEstadoUsuario.SelectedIndex =
                    persona.EstadoUsuario.HasValue && persona.EstadoUsuario.Value ? 0 : 1;
            }
            else
            {
                txtUsuario.Clear();
                cbxRol.SelectedIndex = -1;
                cbxEstadoUsuario.SelectedIndex = -1;
            }
        }

        private void ComprobarChecks()
        {
            if (this.chxCliente.Checked == true)
            {
                this.cbxEstadoCliente.Enabled = true;
                this.cbxEstadoVisualCliente.Enabled = true;

            }
            else
            {
                this.cbxEstadoCliente.Enabled = false;
                this.cbxEstadoVisualCliente.Enabled = false;
            }
            if (this.chxProveedor.Checked == true)
            {
                this.cbxEstadoProv.Enabled = true;
                this.cbxEstadoVisualProv.Enabled = true;
                this.txtRazonSocialProveedor.Enabled = true;
                this.txtDescripcionProveedor.Enabled = true;
            }
            else
            {
                this.cbxEstadoProv.Enabled = false;
                this.cbxEstadoVisualProv.Enabled = false;
                this.txtRazonSocialProveedor.Enabled = false;
                this.txtDescripcionProveedor.Enabled = false;
            }
            if (this.chxUser.Checked == true)
            {
                this.txtUsuario.Enabled = true;
                this.cbxRol.Enabled = true;
                this.cbxEstadoUsuario.Enabled = true;
            }
            else
            {
                this.txtUsuario.Enabled = false;
                this.cbxRol.Enabled = false;
                this.cbxEstadoUsuario.Enabled = false;
            }
        }

        private void chxCliente_CheckedChanged(object sender, EventArgs e)
        {
            this.ComprobarChecks();
        }

        private void chxProveedor_CheckedChanged(object sender, EventArgs e)
        {
            this.ComprobarChecks();
        }

        private void chxUser_CheckedChanged(object sender, EventArgs e)
        {
            this.ComprobarChecks();
        }

