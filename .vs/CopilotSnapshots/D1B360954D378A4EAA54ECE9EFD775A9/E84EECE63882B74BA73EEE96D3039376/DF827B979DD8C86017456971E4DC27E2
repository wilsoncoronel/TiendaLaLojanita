        private async void CrearDevolucionCompra()
        {
            if (this.txtId.Text != "")
            {
                return;
            }

            if (!this.ValidarDevolucionNueva())
            {
                return;
            }

            bool respuesta = this.ConfirmaAccion("Al registrar una devolución se afectará el inventario, ¿está seguro de continuar?");
            if (!respuesta)
                return;

            var devolucionCompra = this.CargarDevolucionCompra();
            prog = new ProgressBar();
            prog.Show();
            var resultado = await this.devolucionCompraService.CrearDevolucionCompra(devolucionCompra);
            prog.Hide();
            if (resultado > 0)
            {
                MessageBox.Show("Devolución de compra creada exitosamente.", "Éxito", MessageBoxButtons.OK, MessageBoxIcon.Information);
                this.LimpiarFormulario();
            }
            else
            {
                MessageBox.Show("Ocurrió un error al crear la devolución de compra.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private bool ValidarDevolucionNueva()
        {
            if (this.cbxProveedor.SelectedValue is not int idProveedor || idProveedor <= 0)
            {
                MessageBox.Show("Seleccione un proveedor.", "Dato requerido", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            if (this.cbxTipoDevolucion.SelectedValue is not int idTipoDevolucion || idTipoDevolucion <= 0)
            {
                MessageBox.Show("Seleccione un tipo de devolución.", "Dato requerido", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            this.SincronizarDetallesDesdeGrilla();
            if (this.detallesDevolucion.All(detalle => detalle.Cantidad <= 0))
            {
                MessageBox.Show("Agregue al menos un artículo con cantidad válida.", "Detalle requerido", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return false;
            }

            return true;
        }

        private bool ConfirmaAccion(string mensaje)
        {
            DialogResult respuesta = MessageBox.Show(
                mensaje,
                "Confirmar",
                MessageBoxButtons.OKCancel,
                MessageBoxIcon.Question
            );
            if (respuesta == DialogResult.OK)
            {
                return true;
            }
            return false;
        }

        private void LimpiarFormulario()
        {
            this.txtBuscarCompra.Clear();
            this.dgvCompraDevolucion.Rows.Clear();
            this.dgvDetalleDevolucion.Rows.Clear();
            this.txtMotivo.Clear();
            this.txtArtículo.Clear();
            this.cbxEstado.SelectedIndex = 0;
            this.cbxTipoDevolucion.SelectedIndex = 0;
            this.dgvTotales.Rows.Clear();
            this.txtTotales.Text = 0m.ToString("C2", CultureInfo.GetCultureInfo("en-US"));
            this.ListaDetallesCompra.Clear();
            this.ListaDetallesDevolucion?.Clear();
            this.detallesDevolucion.Clear();
            this.listaCompras.Clear();
            this.idCompra = 0;
        }

        private DevolucionCompraCreacionDTO CargarDevolucionCompra()
        {
            this.SincronizarDetallesDesdeGrilla();
            var devolucionCompra = new DevolucionCompraCreacionDTO
            {
                Estado = cbxEstado.SelectedIndex == 0 ? 1 : 2,
                FechaCreacion = DateTime.Now,
                Motivo = this.txtMotivo.Text,
                IdProveedor = Convert.ToInt32(this.cbxProveedor.SelectedValue),
                IdTipoDevolucion = Convert.ToInt32(this.cbxTipoDevolucion.SelectedValue),
                DetalleDevolucionCompraCreacionDTO = this.detallesDevolucion
                    .Where(detalle => detalle.Cantidad > 0)
                    .Select(detalle => new DetalleDevolucionCompraCreacionDTO
                    {
                        IdArticulo = detalle.IdArticulo,
                        Cantidad = detalle.Cantidad,
                        Valor = detalle.Valor,
                        Estado = true,
                        ImpuestosDetalleDTO = detalle.Impuestos
                            .Select(impuesto => new DetalleDevolucionCompraImpuestoDTO
                            {
                                IdImpuesto = impuesto.IdImpuesto,
                                Nombre = impuesto.Nombre,
                                TipoCalculo = impuesto.TipoCalculo,
                                Valor = impuesto.Valor,
                                Estado = impuesto.Estado
                            })
                            .ToList()
                    })
                    .ToList()
            };
            return devolucionCompra;
        }
        private void dgvDetalleDevolucion_CellClick_1(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex < 0 ||
                e.ColumnIndex < 0 ||
                dgvDetalleDevolucion.Rows[e.RowIndex].IsNewRow)
            {
                return;
            }

            if (dgvDetalleDevolucion.Columns[e.ColumnIndex].Name == "Quitar")
            {
                this.EliminarDetalleMemoria(dgvDetalleDevolucion.Rows[e.RowIndex]);
                dgvDetalleDevolucion.Rows.RemoveAt(e.RowIndex);
                this.CalcularTotales();
            }
        }

        private void dgvDetalleDevolucion_CellValueChanged(object sender, DataGridViewCellEventArgs e)
        {
            if (e.RowIndex >= 0 &&
                e.ColumnIndex >= 0 &&
                this.dgvDetalleDevolucion.Columns[e.ColumnIndex].Name == "Cantidad")
            {
                this.CalcularTotales();
            }
        }

        private void EliminarDetalleMemoria(DataGridViewRow row)
        {
            if (!int.TryParse(row.Cells["IdArticulo"].Value?.ToString(), out int idArticulo))
            {
                return;
            }

            string lote = row.Cells["Lote"].Value?.ToString() ?? string.Empty;
            string codigo = row.Cells["Codigo"].Value?.ToString() ?? string.Empty;
            var detalle = this.detallesDevolucion.FirstOrDefault(item =>
                item.IdArticulo == idArticulo &&
                string.Equals(item.Lote, lote, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(item.Codigo, codigo, StringComparison.OrdinalIgnoreCase));

            if (detalle != null)
            {
                this.detallesDevolucion.Remove(detalle);
            }
        }

