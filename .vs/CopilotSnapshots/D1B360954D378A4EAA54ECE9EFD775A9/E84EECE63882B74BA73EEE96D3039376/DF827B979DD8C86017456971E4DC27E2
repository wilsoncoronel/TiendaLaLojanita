        private void CargarTablaDetallesDevolucionCompra()
        {
            this.dgvDetalleDevolucion.Rows.Clear();
            this.detallesDevolucion.Clear();

            if (this.ListaDetallesDevolucion != null && this.ListaDetallesDevolucion.Count > 0)
            {
                foreach (var detalle in this.ListaDetallesDevolucion)
                {
                    var detalleCompra = detalle.DetalleCompraDto;
                    if (detalleCompra == null)
                        continue;

                    var detalleMemoria = new DetalleDevolucionMemoria
                    {
                        IdArticulo = detalleCompra.IdArticulo,
                        IdDetalleCompra = detalle.IdDetalleCompra,
                        Codigo = detalleCompra.Codigo ?? string.Empty,
                        Lote = detalleCompra.Lote ?? string.Empty,
                        NombreArticulo = detalleCompra.ArticuloDTO?.Nombre ?? string.Empty,
                        Valor = detalleCompra.ValorCompra,
                        Cantidad = detalle.Cantidad,
                        Impuestos = (detalle.ImpuestosDetalleDTO ?? new List<DetalleDevolucionCompraImpuestoDTO>())
                            .Select(impuesto => new DetalleDevolucionCompraImpuestoDTO
                            {
                                IdImpuesto = impuesto.IdImpuesto,
                                Nombre = impuesto.Nombre,
                                TipoCalculo = impuesto.TipoCalculo,
                                Valor = impuesto.Valor,
                                Estado = impuesto.Estado
                            })
                            .ToList()
                    };

                    this.detallesDevolucion.Add(detalleMemoria);
                    this.AgregarFila(detalleMemoria);
                }
            }
            else
            {
                foreach (var detalle in this.ListaDetallesCompra)
                {
                    var detalleMemoria = new DetalleDevolucionMemoria
                    {
                        IdArticulo = detalle.IdArticulo,
                        IdDetalleCompra = detalle.Id,
                        Codigo = detalle.Codigo ?? string.Empty,
                        Lote = detalle.Lote ?? string.Empty,
                        NombreArticulo = detalle.ArticuloDTO?.Nombre ?? string.Empty,
                        Valor = detalle.ValorCompra,
                        Cantidad = detalle.Cantidad,
                        Impuestos = (detalle.Impuestos ?? new List<DetalleImpuestoCreacionDTO>())
                            .Select(impuesto => new DetalleDevolucionCompraImpuestoDTO
                            {
                                IdImpuesto = impuesto.IdImpuesto,
                                Nombre = impuesto.Nombre,
                                TipoCalculo = impuesto.TipoCalculo,
                                Valor = impuesto.Valor,
                                Estado = true
                            })
                            .ToList()
                    };

                    this.detallesDevolucion.Add(detalleMemoria);
                    this.AgregarFila(detalleMemoria);
                }
            }

            this.CalcularTotales();
        }

        private void CalcularTotales()
        {
            this.SincronizarDetallesDesdeGrilla();
            decimal subtotal = 0m;
            var impuestos = new Dictionary<(int Id, string Nombre), decimal>();

            foreach (var detalle in this.detallesDevolucion)
            {
                subtotal += detalle.Valor * detalle.Cantidad;

                foreach (var impuesto in detalle.Impuestos ?? new List<DetalleDevolucionCompraImpuestoDTO>())
                {
                    decimal valorImpuesto = CalcularImpuestos.Calcular(
                        impuesto.TipoCalculo,
                        detalle.Valor,
                        detalle.Cantidad,
                        impuesto.Valor);

                    var clave = (impuesto.IdImpuesto, impuesto.Nombre ?? string.Empty);
                    impuestos[clave] = impuestos.TryGetValue(clave, out decimal acumulado)
                        ? acumulado + valorImpuesto
                        : valorImpuesto;
                }
            }

            this.dgvTotales.Rows.Clear();
            foreach (var impuesto in impuestos)
            {
                this.dgvTotales.Rows.Add(impuesto.Key.Nombre, impuesto.Value);
            }

            decimal totalGeneral = subtotal + impuestos.Values.Sum();
            this.txtTotales.Text = totalGeneral.ToString("C2", CultureInfo.GetCultureInfo("en-US"));
        }

        private void SincronizarDetallesDesdeGrilla()
        {
            foreach (DataGridViewRow row in this.dgvDetalleDevolucion.Rows)
            {
                if (row.IsNewRow ||
                    !int.TryParse(row.Cells["IdArticulo"].Value?.ToString(), out int idArticulo) ||
                    !int.TryParse(row.Cells["Cantidad"].Value?.ToString(), out int cantidad))
                {
                    continue;
                }

                string lote = row.Cells["Lote"].Value?.ToString() ?? string.Empty;
                string codigo = row.Cells["Codigo"].Value?.ToString() ?? string.Empty;
                var detalle = this.detallesDevolucion.FirstOrDefault(item =>
                    item.IdArticulo == idArticulo &&
                    string.Equals(item.Lote, lote, StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(item.Codigo, codigo, StringComparison.OrdinalIgnoreCase));

                if (detalle != null && cantidad >= 0)
                {
                    detalle.Cantidad = cantidad;
                }
            }
        }

