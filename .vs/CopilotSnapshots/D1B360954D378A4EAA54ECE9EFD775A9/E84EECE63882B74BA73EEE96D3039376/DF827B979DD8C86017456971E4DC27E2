        private void CargarTablaCompra(List<CompraMinDTO> compras)
        {
            if (compras == null || compras.Count == 0)
            {
                MessageBox.Show("No se encontraron compras con el parametro de busqueda.", "Error", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }
            this.dgvCompraDevolucion.Rows.Clear();
            foreach (var compra in compras)
            {
                this.dgvCompraDevolucion.Rows.Add(compra.Id, compra.FechaCompra, compra.Documento, compra.ProveedorMinDto.RazonSocial, compra.EstadoCompra.Nombre);
            }
        }

